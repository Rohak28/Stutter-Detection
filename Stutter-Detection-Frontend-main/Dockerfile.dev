# Development Dockerfile - uses Vite dev server with hot reload
FROM node:18-alpine

WORKDIR /app

# Install dependencies first (cached if package.json doesn't change)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server with host 0.0.0.0 so it's accessible outside container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
